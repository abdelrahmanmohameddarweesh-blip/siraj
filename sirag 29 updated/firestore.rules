rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: false;
    }

    // User profiles & private state
    // Users can only read and write their own documents
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // prevent accidental account wipe via client SDK
    }

    // Personal onboarding data: private to its authenticated owner.
    match /privateProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'gender', 'createdAt', 'profileUpdatedAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.gender in ['male', 'female'];
      allow delete: if false;
    }

    // Sohba writes go through authenticated callable functions, never clients.
    function circleMember(circleId) {
      return request.auth != null && exists(/databases/$(database)/documents/sohbaCircles/$(circleId)/members/$(request.auth.uid));
    }
    match /sohbaAccounts/{uid}/circles/{circleId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /sohbaCircles/{circleId} {
      allow read: if circleMember(circleId);
      allow write: if false;
      match /members/{uid} {
        // Even the creator cannot read someone else's goals, tokens or amounts.
        allow read: if circleMember(circleId) && request.auth.uid == uid;
        allow write: if false;
        match /days/{day} {
          allow read: if circleMember(circleId) && request.auth.uid == uid;
          allow write: if false;
        }
      }
      match /companions/{uid} {
        allow read: if circleMember(circleId);
        allow write: if false;
      }
      match /days/{day} {
        allow read: if circleMember(circleId) && (!('showGroupProgress' in get(/databases/$(database)/documents/sohbaCircles/$(circleId)).data) || get(/databases/$(database)/documents/sohbaCircles/$(circleId)).data.showGroupProgress != false);
        allow write: if false;
      }
      match /encouragement/{id} {
        // Served by sohbaFeed with current aliases, including legacy records.
        allow read: if false;
        allow write: if false;
      }
    }

    // Public / Global Leaderboards
    // Anyone authenticated can read; updates restricted to matching user
    match /leaderboard/{entry} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    // Daily Championship submissions
    match /championship/{entry} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Community Feed Posts
    // Anyone authenticated can read; author can create; cannot edit/delete other posts
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Group Quiz / Multiplayer Arena Rooms
    // Authenticated users can read room state, host can update settings, participants can submit answers
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;

      // Subcollection for room players
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == playerId;
      }
    }
  }
}
