# Optional Pronunciation & Audio DSP Analysis Server URL (e.g. http://192.168.1.100:5001)
# When empty or unset, the app uses on-device audio analysis.
EXPO_PUBLIC_DSP_SERVER_URL=

# Optional HTTPS Firebase Hosting invitation page (e.g. https://batal-moslem.web.app).
# Until configured, sharing includes a join code and the installed-app scheme.
EXPO_PUBLIC_INVITE_BASE_URL=

# Local development ONLY. Forces demo-siraj project and emulator connections.
# Set to your development machine LAN IP when testing from a physical phone.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# For scripts/configure-sohba-links.cjs (public app association identifiers, not secrets).
SIRAJ_APPLE_TEAM_ID=
SIRAJ_ANDROID_SHA256_FINGERPRINTS=

# Public Firebase WEB app configuration, copied as a matching set from Project settings.
# Blank values use the original bundled configuration; these are not admin credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
